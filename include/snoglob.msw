/* snoglob.msw -- Shared global state for SNOBOL4 interpreter modules
 *
 * All modules include this to share variable declarations.
 * The main module provides the actual storage; library modules
 * get duplicate labels that the assembler resolves to the first.
 */

/* Token types */
%DEFINE TK_IDENT 1;
%DEFINE TK_INT 2;
%DEFINE TK_STR 3;
%DEFINE TK_EQ 4;
%DEFINE TK_LPAREN 5;
%DEFINE TK_RPAREN 6;
%DEFINE TK_COLON 7;
%DEFINE TK_PLUS 9;
%DEFINE TK_MINUS 10;
%DEFINE TK_EOL 11;
%DEFINE TK_EOF 12;
%DEFINE TK_DOT 13;
%DEFINE TK_STAR 14;
%DEFINE TK_LT 15;
%DEFINE TK_GT 16;

/* Statement / expression / goto types */
%DEFINE ST_EMPTY 0;
%DEFINE ST_ASSIGN 1;
%DEFINE ST_END 2;
%DEFINE ST_MATCH 3;
%DEFINE ST_REPL 7;
%DEFINE OE_NONE 0;
%DEFINE OE_IDENT 1;
%DEFINE OE_INT 2;
%DEFINE OE_STR 3;
%DEFINE OE_BINOP 4;
%DEFINE OE_SPAN 5;
%DEFINE OE_BREAK 6;
%DEFINE OE_REM 7;
%DEFINE OE_CAP 8;
%DEFINE OE_ARRAY 9;
%DEFINE OE_ARRREF 10;
%DEFINE OE_FNCALL 11;
%DEFINE OE_LEN 12;
%DEFINE OE_LEN_VAR 13;
%DEFINE OE_SIZE 14;
%DEFINE OE_SUBSTR 15;
%DEFINE OE_CHAR 16;
/* In-stream binary-op markers for nested expressions inside
 * builtin arg lists (saga-expr-completeness step 003). The
 * lowering's postfix walk emits the corresponding OP_* when it
 * sees these. Distinct from the statement-level S_OEOP scheme
 * because builtin args can have their own per-arg arith. */
%DEFINE OE_OP_ADD 17;
%DEFINE OE_OP_SUB 18;
%DEFINE OE_OP_MUL 19;
%DEFINE OE_OP_MOD 20;
%DEFINE OE_ANY 21;          /* pattern: ANY('class') -- match one char */
%DEFINE GT_RET 4;
%DEFINE GT_FRET 5;
%DEFINE GT_NONE 0;
%DEFINE GT_UNCOND 1;
%DEFINE GT_SUCC 2;
%DEFINE GT_FAIL 3;

/* Variable type tags */
%DEFINE VTYP_INT 0;
%DEFINE VTYP_STR 1;
%DEFINE VTYP_PAT 2;
%DEFINE VTYP_ARR 3;
%DEFINE VTYP_PAT_SPAN 4;
%DEFINE VTYP_PAT_BREAK 5;

/* Source buffer + load addresses */
%DEFINE SRC_LOAD_ADDR 524288;
%DEFINE INP_LOAD_ADDR 589824;

/* Symbol table size -- also governs VARS, SYMV, VTYP */
%DEFINE SYMMAX 64;
%DEFINE SYM_WIDTH 12;       /* bytes per symbol name (max name = SYM_WIDTH-1 chars) */

/* Statement table size -- also governs S_TYP, S_EPCNT, STMT_ADDR, etc.
 * Raised 256 -> 1024 to fix the dcftn brief
 * "dcsno-static-program-size-limit": programs above ~234 stmts
 * silently truncated and corrupted control flow. PARSE now emits a
 * compile-time diagnostic when this cap is hit (issue analogous to
 * the SRC_LIMIT and SB_LIMIT overflow paths). */
%DEFINE STMAX 1024;

/* Slots per statement for expression parts (EP) and pattern parts (PP).
 * EP_TYP[STMAX*EPSLOTS], PP_TYP[STMAX*EPSLOTS]. Code uses S*EPSLOTS.
 * Bumped 8 -> 16 (dcsno-concat-truncation) then 16 -> 32 to fix
 * dcsno-pattern-captures-truncation: 4+ `.` captures with key=
 * separators (3 slots per capture group) need 12+ slots; 6 captures
 * = 18 slots > 16. 32 covers up to ~10 captures with separators.
 * Higher counts ("stretch" cases with 12+ captures) need pattern
 * restructuring -- separate saga, with a compile-time diagnostic
 * added in PARSE for the overflow path. */
%DEFINE EPSLOTS 32;
%DEFINE EPMAX 32768;      /* STMAX * EPSLOTS = 1024 * 32 */

/* Eval stack depth */
%DEFINE ESTK_DEPTH 256;

/* AM code buffer size (bytes) */
%DEFINE AM_CODE_SIZE 4096;

/* Array pool: ARR_MAX arrays, each up to ARR_ELEMS elements.
 * ARR_DATA and ARR_TYP sized as ARR_MAX * ARR_ELEMS. */
%DEFINE ARR_MAX 8;
%DEFINE ARR_ELEMS 50;
%DEFINE ARR_POOL 400;     /* ARR_MAX * ARR_ELEMS = 8 * 50 */

/* Label table */
%DEFINE LBL_MAX 64;

/* Shared globals -- declared in every module.
 * Assembler uses first definition (from main module). */

/* Source buffer -- 64KB. History: 8KB silently truncated mid-line
 * (issue #14) -> 12KB with diagnostic -> 64KB to unblock dcftn's
 * FTI-0 emit_asm.sno (dcsno-source-byte-cap brief, sibling to the
 * STMAX 256 -> 1024 bump). READ_SRC still sets SB_OVERFLOW with a
 * diagnostic when input exceeds SRC_LIMIT; the cap itself just got
 * comfortable headroom. */
%DEFINE SRC_SIZE 65536;
%DEFINE SRC_LIMIT 65528;    /* SRC_SIZE - 8, headroom for null terminator */
DCL SRC(SRC_SIZE) BYTE;
DCL INP_POS INT STATIC INIT(0);
DCL SPOS INT STATIC INIT(0);
DCL TT INT STATIC INIT(0);
DCL INP_TTY INT STATIC INIT(0);
DCL TV INT STATIC INIT(0);
DCL TB(128) CHAR INIT('                                                                                                                                ');
DCL TN INT STATIC INIT(0);
DCL LHAS_LBL INT STATIC INIT(0);
DCL AT_SOL INT STATIC INIT(1);

/* String buffer -- 16KB. No GC/compaction: every concat result, read
 * input line, and pattern capture appends at SBPOS. Previous 4KB size
 * caused silent memory corruption (issue #11) in realistic programs.
 * SB_LIMIT reserves headroom (128 bytes) so a single oversized operand
 * can't overshoot while we detect the overflow. See issue #12. */
%DEFINE SB_SIZE 65536;
%DEFINE SB_SOFT_LIMIT 61440;    /* SB_SIZE - 4096 (compact trigger) */
%DEFINE SB_LIMIT 65024;         /* SB_SIZE - 512 (hard abort) */
DCL SB(SB_SIZE) BYTE;
DCL SBPOS INT STATIC INIT(0);

/* Symbol table -- sizes must match SYMMAX */
DCL SYMN(768) BYTE;       /* SYMMAX * SYM_WIDTH = 64 * 12 */
DCL SYMV(SYMMAX) INT;
DCL SYMC INT STATIC INIT(0);
DCL VTYP(SYMMAX) INT;

/* Label table */
DCL LBLN(768) BYTE;       /* LBL_MAX * SYM_WIDTH = 64 * 12 */
DCL LBLS(LBL_MAX) INT;
DCL LBLC INT STATIC INIT(0);

/* Statement table -- sizes must match STMAX */
DCL S_TYP(STMAX) INT;
DCL S_SUBJ(STMAX) INT;
DCL S_SIDX(STMAX) INT;
DCL S_OETY(STMAX) INT;
DCL S_OEV1(STMAX) INT;
DCL S_OEOP(STMAX) INT;
DCL S_OEV2(STMAX) INT;
DCL S_GTYP(STMAX) INT;
DCL S_GLBL(STMAX) INT;
DCL S_SPTR(STMAX) INT;
DCL STCNT INT STATIC INIT(0);
DCL S_EPCNT(STMAX) INT;
DCL EP_TYP(EPMAX) INT;    /* STMAX * EPSLOTS */
DCL EP_VAL(EPMAX) INT;
DCL S_PPCNT(STMAX) INT;
DCL PP_TYP(EPMAX) INT;    /* STMAX * EPSLOTS */
DCL PP_VAL(EPMAX) INT;
DCL S_GOTO_OFF(STMAX) INT;

/* Combined :S(...) :F(...) goto support (dcsno-combined-goto-parser
 * brief). A statement can carry BOTH an S-branch and an F-branch.
 * The first goto on a statement uses the existing S_GTYP / S_GLBL /
 * S_GOTO_OFF slots; when a second goto of the OPPOSITE direction
 * appears, its target lands in S_GLBL_F and the parser leaves
 * S_GTYP=GT_SUCC so the lowering code emits both branch ops.
 * S_GOTO_OFF_F is the bytecode patch site for the failure branch.
 * Two new arrays (instead of four) keeps the PL/SW emit buffer
 * under EMIT_BUF_SIZE; STMAX-sized INT arrays cost ~768 bytes of
 * `.byte` output each. Reversed-order `:F(L1):S(L2)` is handled by
 * the parser rotating S_GLBL into S_GLBL_F when the second goto
 * arrives. -1 sentinel = "no F branch on this statement". */
DCL S_GLBL_F(STMAX) INT;
DCL S_GOTO_OFF_F(STMAX) INT;

/* AM code buffer */
DCL AM_CODE(AM_CODE_SIZE) BYTE;
DCL AM_PC INT STATIC INIT(0);
DCL STMT_ADDR(STMAX) INT;

/* Eval stack + variables */
DCL ESTK(ESTK_DEPTH) INT;
DCL ETYP(ESTK_DEPTH) INT;
DCL ESP INT STATIC INIT(0);
DCL VARS(SYMMAX) INT;
DCL LAST_PUSH_TYP INT STATIC INIT(0);

/* Executor state shared across handler procedures */
DCL X_PC INT STATIC INIT(0);
DCL X_OP INT STATIC INIT(0);
DCL X_V INT STATIC INIT(0);
DCL X_IDX INT STATIC INIT(0);

/* Debug: per-statement execution counters */
DCL ST_EXEC(STMAX) INT;

/* Array pool -- sizes must match ARR_MAX * ARR_ELEMS */
DCL ARR_DATA(ARR_POOL) INT;
DCL ARR_TYP(ARR_POOL) INT;
DCL ARR_CNT INT STATIC INIT(0);

/* Pattern stack -- must hold all pattern parts of the largest
 * single-statement pattern. Sized to match EPSLOTS so any pattern
 * that fits the parser fits the runtime stack. Was a hard 16
 * before the dcsno-pattern-captures-truncation fix; that capped
 * useful captures at ~5 when each had a key= separator. */
%DEFINE PSTK_DEPTH 32;        /* match EPSLOTS */
DCL PSTK(PSTK_DEPTH) INT;
DCL PSTYP(PSTK_DEPTH) INT;
DCL PSTOP INT STATIC INIT(0);

/* User function table (max 4 single-arg functions) */
DCL FN_NAME(4) INT;     /* sym idx of function name */
DCL FN_NAMOFF(4) INT;   /* SB offset of fn name (for label lookup) */
DCL FN_PARAM(4) INT;    /* sym idx of param var */
DCL FN_ENTRY(4) INT;    /* statement idx of function entry */
DCL FN_CNT INT STATIC INIT(0);

/* Call stack: saved PC and saved param value (single-arg) */
DCL CSTK_PC(16) INT;
DCL CSTK_PV(16) INT;
DCL CSTK_FN(16) INT;
DCL CSTK_TOP INT STATIC INIT(0);

/* Result + special symbols */
DCL LAST_RESULT INT STATIC INIT(1);
DCL OUT_SYM INT STATIC INIT(0);
DCL INP_SYM INT STATIC INIT(0);
DCL NL(3) CHAR INIT('
');
DCL N_OUT(8) CHAR INIT('OUTPUT');
DCL N_INP(8) CHAR INIT('INPUT');
DCL N_RAWINP(12) CHAR INIT('RAWINPUT');
DCL RAWINP_SYM INT STATIC INIT(0);

/* SB overflow abort: set by SB_ABORT, checked by AM_EXEC loop. */
DCL SB_OVERFLOW INT STATIC INIT(0);
DCL SB_OVF_MSG(48) CHAR INIT('SNOBOL4: string buffer overflow at SBPOS=');
DCL SRC_OVF_MSG(48) CHAR INIT('SNOBOL4: source too large, truncated at byte=');
DCL STMT_OVF_MSG(56) CHAR INIT('SNOBOL4: program exceeds STMAX statements at STCNT=');
DCL EP_OVF_MSG(56) CHAR INIT('SNOBOL4: pattern parts exceed EPSLOTS in statement ');

/* SB compaction watermark: set at start of AM_EXEC to the end of the
 * compile-time string pool. Strings below this are stable (referenced
 * by bytecode); strings at or above this are runtime-allocated and
 * may be compacted. See issue #12. */
DCL SB_COMPILE_END INT STATIC INIT(0);

/* SB compaction forwarding tables. Sized for typical live-string set
 * at compaction time; compaction is skipped if we'd exceed this. */
%DEFINE SB_FWD_MAX 128;
DCL SB_FWD_OLD(SB_FWD_MAX) INT;
DCL SB_FWD_NEW(SB_FWD_MAX) INT;
DCL SB_FWD_CNT INT STATIC INIT(0);
