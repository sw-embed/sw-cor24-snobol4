/* sno_lex.plsw -- Layer 2: lexer, parser, symbol/label tables
 * Depends on: sno_util (L1)
/* */
%DEFINE LIBRARY;
%INCLUDE descr;
%INCLUDE heap;
%INCLUDE am;
%INCLUDE pat;
%INCLUDE snoglob;

IS_A: PROC(C INT) RETURNS(INT);
    IF (C >= 65) THEN IF (C <= 90) THEN RETURN(1);
    IF (C >= 97) THEN IF (C <= 122) THEN RETURN(1);
    RETURN(0);
END;

IS_D: PROC(C INT) RETURNS(INT);
    IF (C >= 48) THEN IF (C <= 57) THEN RETURN(1);
    RETURN(0);
END;

IS_AN: PROC(C INT) RETURNS(INT);
    IF (IS_A(C) != 0) THEN RETURN(1);
    IF (IS_D(C) != 0) THEN RETURN(1);
    RETURN(0);
END;

LEX: PROC;
    DCL C INT;
    DCL I INT;
    DCL Q INT;
    C = SRC(SPOS);
    /* Column-1 '*' = full-line comment (SNOBOL4 convention) */
    IF (AT_SOL = 1 AND C = 42) THEN DO;
        AT_SOL = 0;
        DO WHILE (C != 10 AND C != 0);
            SPOS = SPOS + 1;
            C = SRC(SPOS);
        END;
        IF (C = 10) THEN DO;
            SPOS = SPOS + 1;
            AT_SOL = 1;
        END;
        TT = TK_EOL;
        RETURN;
    END;
    IF (AT_SOL = 1) THEN DO;
        AT_SOL = 0;
        IF (C != 32 AND C != 9 AND C != 10 AND C != 0) THEN
            LHAS_LBL = 1;
        ELSE
            LHAS_LBL = 0;
    END;
    DO WHILE (C = 32 OR C = 9);
        SPOS = SPOS + 1;
        C = SRC(SPOS);
    END;
    IF (C = 0) THEN DO; TT = TK_EOF; RETURN; END;
    IF (C = 10) THEN DO;
        SPOS = SPOS + 1;
        /* Continuation line: '+' or '.' in column 1 -> keep lexing */
        IF (SRC(SPOS) = 43 OR SRC(SPOS) = 46) THEN DO;
            SPOS = SPOS + 1;
            AT_SOL = 0;
            LHAS_LBL = 0;
            CALL LEX;
            RETURN;
        END;
        TT = TK_EOL; AT_SOL = 1; RETURN;
    END;
    IF (C = 61) THEN DO; SPOS = SPOS + 1; TT = TK_EQ; RETURN; END;
    IF (C = 46) THEN DO; SPOS = SPOS + 1; TT = TK_DOT; RETURN; END;
    IF (C = 40) THEN DO; SPOS = SPOS + 1; TT = TK_LPAREN; RETURN; END;
    IF (C = 41) THEN DO; SPOS = SPOS + 1; TT = TK_RPAREN; RETURN; END;
    IF (C = 58) THEN DO; SPOS = SPOS + 1; TT = TK_COLON; RETURN; END;
    IF (C = 43) THEN DO; SPOS = SPOS + 1; TT = TK_PLUS; RETURN; END;
    IF (C = 45) THEN DO; SPOS = SPOS + 1; TT = TK_MINUS; RETURN; END;
    IF (C = 42) THEN DO; SPOS = SPOS + 1; TT = TK_STAR; RETURN; END;
    IF (C = 60) THEN DO; SPOS = SPOS + 1; TT = TK_LT; RETURN; END;
    IF (C = 62) THEN DO; SPOS = SPOS + 1; TT = TK_GT; RETURN; END;
    IF (C = 44) THEN DO; SPOS = SPOS + 1; TT = 17; RETURN; END;
    IF (C = 39 OR C = 34) THEN DO;
        Q = C;
        SPOS = SPOS + 1;
        I = 0;
        C = SRC(SPOS);
        DO WHILE (C != Q AND C != 0 AND C != 10);
            IF (I < 127) THEN DO; TB(I) = C; I = I + 1; END;
            SPOS = SPOS + 1;
            C = SRC(SPOS);
        END;
        IF (C = Q) THEN SPOS = SPOS + 1;
        TB(I) = 0;
        TN = I;
        TT = TK_STR;
        RETURN;
    END;
    IF (IS_D(C) != 0) THEN DO;
        TV = 0;
        DO WHILE (IS_D(SRC(SPOS)) != 0);
            C = SRC(SPOS);
            SPOS = SPOS + 1;
            TV = TV * 10 + (C - 48);
        END;
        TT = TK_INT;
        RETURN;
    END;
    IF (IS_A(C) != 0) THEN DO;
        I = 0;
        DO WHILE (IS_AN(SRC(SPOS)) != 0);
            C = SRC(SPOS);
            SPOS = SPOS + 1;
            IF (C >= 97) THEN IF (C <= 122) THEN C = C - 32;
            IF (I < 31) THEN DO; TB(I) = C; I = I + 1; END;
        END;
        TB(I) = 0;
        TN = I;
        TT = TK_IDENT;
        RETURN;
    END;
    /* Skip comment lines (starting with *) */
    IF (C = 42) THEN DO;
        DO WHILE (C != 10 AND C != 0);
            SPOS = SPOS + 1;
            C = SRC(SPOS);
        END;
        IF (C = 10) THEN DO; SPOS = SPOS + 1; AT_SOL = 1; END;
        TT = TK_EOL;
        RETURN;
    END;
    SPOS = SPOS + 1;
    TT = TK_EOF;
END;

/* ================================================================
/* ================================================================
 * Symbol + Label tables
/* ================================================================ */

/* SYMN, SYMV, SYMC declared in snoglob.msw */

SYM_FIND: PROC(NOFF INT) RETURNS(INT);
    DCL I INT;
    DCL NP PTR;
    I = 0;
    DO WHILE (I < SYMC);
        NP = ADDR(SYMN) + I * SYM_WIDTH;
        IF (SCEQ(NP, ADDR(SB) + NOFF) != 0) THEN RETURN(I);
        I = I + 1;
    END;
    RETURN(0 - 1);
END;

SYM_ADD: PROC(NOFF INT) RETURNS(INT);
    DCL IDX INT;
    DCL NP PTR;
    DCL SRP PTR;
    DCL I INT;
    DCL C INT;
    IF (SYMC >= SYMMAX) THEN RETURN(0 - 1);
    IDX = SYMC;
    NP = ADDR(SYMN) + IDX * SYM_WIDTH;
    SRP = ADDR(SB) + NOFF;
    I = 0;
    C = 1;
    DO WHILE (C != 0 AND I < 11);
        DCL DP PTR;
        DCL RP PTR;
        RP = SRP + I;
        C = RP->DTAG;
        DP = NP + I;
        DP->DTAG = C;
        I = I + 1;
    END;
    DCL EP PTR;
    EP = NP + I;
    EP->DTAG = 0;
    SYMV(IDX) = 0;
    SYMC = SYMC + 1;
    RETURN(IDX);
END;

SYM_LOOKUP: PROC(NOFF INT) RETURNS(INT);
    DCL IDX INT;
    IDX = SYM_FIND(NOFF);
    IF (IDX >= 0) THEN RETURN(IDX);
    RETURN(SYM_ADD(NOFF));
END;

/* ================================================================
 * Label table
/* ================================================================ */

/* LBLN, LBLS, LBLC, LBL_MAX declared in snoglob.msw */

LBL_ADD: PROC(NOFF INT, STNUM INT);
    DCL NP PTR;
    DCL SRP PTR;
    DCL I INT;
    DCL C INT;
    IF (LBLC >= LBL_MAX) THEN RETURN;
    NP = ADDR(LBLN) + LBLC * SYM_WIDTH;
    SRP = ADDR(SB) + NOFF;
    I = 0;
    C = 1;
    DO WHILE (C != 0 AND I < 11);
        DCL DP PTR;
        DCL RP PTR;
        RP = SRP + I;
        C = RP->DTAG;
        DP = NP + I;
        DP->DTAG = C;
        I = I + 1;
    END;
    DCL EP PTR;
    EP = NP + I;
    EP->DTAG = 0;
    LBLS(LBLC) = STNUM;
    LBLC = LBLC + 1;
END;

LBL_FIND: PROC(NOFF INT) RETURNS(INT);
    DCL I INT;
    DCL NP PTR;
    I = 0;
    DO WHILE (I < LBLC);
        NP = ADDR(LBLN) + I * SYM_WIDTH;
        IF (SCEQ(NP, ADDR(SB) + NOFF) != 0) THEN RETURN(LBLS(I));
        I = I + 1;
    END;
    RETURN(0 - 1);
END;

/* ================================================================
 * Statement table (max 16)
/* ================================================================ */

/* STMAX defined in snoglob.msw.
 * S_TYP, S_SUBJ, S_SIDX, S_OETY, S_OEV1, S_OEOP, S_OEV2, S_GTYP, S_GLBL, S_SPTR, STCNT in snoglob.msw */

/* Expression parts for concatenation: up to 4 parts per statement.
 * S_EPCNT(s) = number of parts (0 = use S_OETY/S_OEV1 as before).
/* EP_TYP(s*4+i) = part type (OE_INT, OE_STR, OE_IDENT).
 * EP_VAL(s*4+i) = part value (int, str offset, sym idx). */
/* S_EPCNT, EP_TYP, EP_VAL declared in snoglob.msw */

/* Pattern parts for compound match statements.
 * PP_TYP: OE_IDENT=var, OE_STR=literal, OE_SPAN, OE_BREAK, OE_REM, OE_CAP.
/* PP_VAL: sym idx, str offset, or class offset.
 * PP_VAL2: for OE_CAP = capture var idx. */
%DEFINE OE_BREAK 6;
%DEFINE OE_REM 7;
%DEFINE OE_CAP 8;
%DEFINE OE_ARRAY 9;
%DEFINE OE_ARRREF 10;
/* S_PPCNT, PP_TYP, PP_VAL declared in snoglob.msw */

/* ================================================================
 * Parser
/* ================================================================ */

/* Parse function name and param from a "FNNAME(PARAM)" string in TB
 * Returns 0 on success. Registers entry in FN table with FN_ENTRY=-1. */
DEF_PARSE: PROC RETURNS(INT);
    DCL I INT;
    DCL J INT;
    DCL NOFF1 INT;
    DCL NOFF2 INT;
    DCL DP PTR;
    DCL C INT;
    DCL FNS INT;
    DCL PRS INT;
    IF (FN_CNT >= 4) THEN RETURN(0 - 1);
    /* Copy fn name into SB */
    NOFF1 = SBPOS;
    I = 0;
    C = TB(I);
    DO WHILE (C != 0 AND C != 40);
        DP = ADDR(SB) + SBPOS;
        DP->DTAG = C;
        SBPOS = SBPOS + 1;
        I = I + 1;
        C = TB(I);
    END;
    DP = ADDR(SB) + SBPOS;
    DP->DTAG = 0;
    SBPOS = SBPOS + 1;
    IF (C != 40) THEN RETURN(0 - 1);
    I = I + 1;
    /* Copy param name */
    NOFF2 = SBPOS;
    C = TB(I);
    DO WHILE (C != 0 AND C != 41);
        DP = ADDR(SB) + SBPOS;
        DP->DTAG = C;
        SBPOS = SBPOS + 1;
        I = I + 1;
        C = TB(I);
    END;
    DP = ADDR(SB) + SBPOS;
    DP->DTAG = 0;
    SBPOS = SBPOS + 1;
    FNS = SYM_LOOKUP(NOFF1);
    PRS = SYM_LOOKUP(NOFF2);
    FN_NAME(FN_CNT) = FNS;
    FN_NAMOFF(FN_CNT) = NOFF1;
    FN_PARAM(FN_CNT) = PRS;
    FN_ENTRY(FN_CNT) = 0 - 1;
    FN_CNT = FN_CNT + 1;
    RETURN(0);
END;

/* SYM idx -> builtin code: 1=IDENT,2=DIFFER,3=GT,4=EQ,5=LE; 0=none */
BLT_CODE: PROC(SIDX INT) RETURNS(INT);
    DCL NP PTR;
    DCL P1 PTR;
    DCL P2 PTR;
    DCL P3 PTR;
    DCL P4 PTR;
    DCL P5 PTR;
    NP = ADDR(SYMN) + SIDX * SYM_WIDTH;
    P1 = NP + 1;
    P2 = NP + 2;
    P3 = NP + 3;
    P4 = NP + 4;
    P5 = NP + 5;
    IF (NP->DTAG = 73) THEN IF (P1->DTAG = 68) THEN IF (P2->DTAG = 69) THEN
        IF (P3->DTAG = 78) THEN IF (P4->DTAG = 84) THEN IF (P5->DTAG = 0) THEN
            RETURN(1);
    IF (NP->DTAG = 68) THEN IF (P1->DTAG = 73) THEN IF (P2->DTAG = 70) THEN
        IF (P3->DTAG = 70) THEN IF (P4->DTAG = 69) THEN IF (P5->DTAG = 82) THEN
            RETURN(2);
    IF (NP->DTAG = 71) THEN IF (P1->DTAG = 84) THEN IF (P2->DTAG = 0) THEN
        RETURN(3);
    IF (NP->DTAG = 69) THEN IF (P1->DTAG = 81) THEN IF (P2->DTAG = 0) THEN
        RETURN(4);
    IF (NP->DTAG = 76) THEN IF (P1->DTAG = 69) THEN IF (P2->DTAG = 0) THEN
        RETURN(5);
    RETURN(0);
END;

FN_FIND: PROC(SIDX INT) RETURNS(INT);
    DCL I INT;
    I = 0;
    DO WHILE (I < FN_CNT);
        IF (FN_NAME(I) = SIDX) THEN RETURN(I);
        I = I + 1;
    END;
    RETURN(0 - 1);
END;

/* PARSE_NESTED_FN -- parse a nested SUBSTR / SIZE / CHAR call into
 * EP slots starting at START_EPI, return the new EPI on success or
 * START_EPI on no-match.
 *
 * Called from the builtin-predicate arg parser (IDENT/DIFFER/EQ etc.)
 * so a statement like  IDENT(SUBSTR('CAB',1,1), 'C')  doesn't drop
 * its goto: the previous parser stored "SUBSTR" as a plain OE_IDENT
 * and then choked on the inner `(`, leaving TT mid-expression so the
 * statement-end goto-attachment logic was unreachable.
 *
 * On entry: TT = TK_IDENT, TB holds the function name, EP slots
 *           [EPB+START_EPI..) are free.
 * On exit (success): TT past the closing `)` of the nested call.
 *           Returns the new EPI (caller's slot counter).
 * On exit (no match): TT unchanged. Returns START_EPI (the caller
 *           should fall back to simple-primitive parsing).
 *
 * Slot layout matches the assignment-context parser at PARSE: PROC's
 * SUBSTR/SIZE/CHAR blocks: each arg is an EP slot, then a marker slot
 * (OE_SUBSTR / OE_SIZE / OE_CHAR) signals "consume the previous N
 * slots as args to this builtin." The lowering walks slots in order
 * and dispatches on EP_TYP.
 */
PARSE_NESTED_FN: PROC(EPB INT, START_EPI INT) RETURNS(INT);
    DCL EPI INT;
    DCL BLT_AI INT;
    EPI = START_EPI;

    IF (TT != TK_IDENT) THEN RETURN(START_EPI);

    /* SUBSTR(STR, POS, LEN) */
    IF (TB(0) = 83 AND TB(1) = 85 AND TB(2) = 66 AND TB(3) = 83 AND TB(4) = 84 AND TB(5) = 82 AND TB(6) = 0) THEN DO;
        BLT_AI = EPI;
        CALL LEX;
        IF (TT != TK_LPAREN) THEN RETURN(START_EPI);
        CALL LEX;
        IF (TT = TK_IDENT) THEN DO;
            DCL N1 INT;
            N1 = SBSAVE();
            IF (EPI < EPSLOTS) THEN DO;
                EP_TYP(EPB + EPI) = OE_IDENT;
                EP_VAL(EPB + EPI) = SYM_LOOKUP(N1);
                EPI = EPI + 1;
            END;
            CALL LEX;
        END;
        ELSE IF (TT = TK_STR) THEN DO;
            IF (EPI < EPSLOTS) THEN DO;
                EP_TYP(EPB + EPI) = OE_STR;
                EP_VAL(EPB + EPI) = SBSAVE();
                EPI = EPI + 1;
            END;
            CALL LEX;
        END;
        IF (TT = 17) THEN CALL LEX;
        IF (TT = TK_INT) THEN DO;
            IF (EPI < EPSLOTS) THEN DO;
                EP_TYP(EPB + EPI) = OE_INT;
                EP_VAL(EPB + EPI) = TV;
                EPI = EPI + 1;
            END;
            CALL LEX;
        END;
        ELSE IF (TT = TK_IDENT) THEN DO;
            DCL N2 INT;
            N2 = SBSAVE();
            IF (EPI < EPSLOTS) THEN DO;
                EP_TYP(EPB + EPI) = OE_IDENT;
                EP_VAL(EPB + EPI) = SYM_LOOKUP(N2);
                EPI = EPI + 1;
            END;
            CALL LEX;
        END;
        IF (TT = 17) THEN CALL LEX;
        IF (TT = TK_INT) THEN DO;
            IF (EPI < EPSLOTS) THEN DO;
                EP_TYP(EPB + EPI) = OE_INT;
                EP_VAL(EPB + EPI) = TV;
                EPI = EPI + 1;
            END;
            CALL LEX;
        END;
        ELSE IF (TT = TK_IDENT) THEN DO;
            DCL N3 INT;
            N3 = SBSAVE();
            IF (EPI < EPSLOTS) THEN DO;
                EP_TYP(EPB + EPI) = OE_IDENT;
                EP_VAL(EPB + EPI) = SYM_LOOKUP(N3);
                EPI = EPI + 1;
            END;
            CALL LEX;
        END;
        IF (TT = TK_RPAREN) THEN CALL LEX;
        IF (EPI < EPSLOTS) THEN DO;
            EP_TYP(EPB + EPI) = OE_SUBSTR;
            IF (BLT_AI > 0) THEN
                EP_VAL(EPB + EPI) = 0 - BLT_AI;
            ELSE
                EP_VAL(EPB + EPI) = 0;
            EPI = EPI + 1;
        END;
        RETURN(EPI);
    END;

    /* SIZE(STR) */
    IF (TB(0) = 83 AND TB(1) = 73 AND TB(2) = 90 AND TB(3) = 69 AND TB(4) = 0) THEN DO;
        BLT_AI = EPI;
        CALL LEX;
        IF (TT != TK_LPAREN) THEN RETURN(START_EPI);
        CALL LEX;
        IF (TT = TK_IDENT) THEN DO;
            DCL SZ1 INT;
            SZ1 = SBSAVE();
            IF (EPI < EPSLOTS) THEN DO;
                EP_TYP(EPB + EPI) = OE_IDENT;
                EP_VAL(EPB + EPI) = SYM_LOOKUP(SZ1);
                EPI = EPI + 1;
            END;
            CALL LEX;
        END;
        ELSE IF (TT = TK_STR) THEN DO;
            IF (EPI < EPSLOTS) THEN DO;
                EP_TYP(EPB + EPI) = OE_STR;
                EP_VAL(EPB + EPI) = SBSAVE();
                EPI = EPI + 1;
            END;
            CALL LEX;
        END;
        IF (TT = TK_RPAREN) THEN CALL LEX;
        IF (EPI < EPSLOTS) THEN DO;
            EP_TYP(EPB + EPI) = OE_SIZE;
            IF (BLT_AI > 0) THEN
                EP_VAL(EPB + EPI) = 0 - BLT_AI;
            ELSE
                EP_VAL(EPB + EPI) = 0;
            EPI = EPI + 1;
        END;
        RETURN(EPI);
    END;

    /* CHAR(CODE) */
    IF (TB(0) = 67 AND TB(1) = 72 AND TB(2) = 65 AND TB(3) = 82 AND TB(4) = 0) THEN DO;
        BLT_AI = EPI;
        CALL LEX;
        IF (TT != TK_LPAREN) THEN RETURN(START_EPI);
        CALL LEX;
        IF (TT = TK_INT) THEN DO;
            IF (EPI < EPSLOTS) THEN DO;
                EP_TYP(EPB + EPI) = OE_INT;
                EP_VAL(EPB + EPI) = TV;
                EPI = EPI + 1;
            END;
            CALL LEX;
        END;
        ELSE IF (TT = TK_IDENT) THEN DO;
            DCL CH1 INT;
            CH1 = SBSAVE();
            IF (EPI < EPSLOTS) THEN DO;
                EP_TYP(EPB + EPI) = OE_IDENT;
                EP_VAL(EPB + EPI) = SYM_LOOKUP(CH1);
                EPI = EPI + 1;
            END;
            CALL LEX;
        END;
        IF (TT = TK_RPAREN) THEN CALL LEX;
        IF (EPI < EPSLOTS) THEN DO;
            EP_TYP(EPB + EPI) = OE_CHAR;
            IF (BLT_AI > 0) THEN
                EP_VAL(EPB + EPI) = 0 - BLT_AI;
            ELSE
                EP_VAL(EPB + EPI) = 0;
            EPI = EPI + 1;
        END;
        RETURN(EPI);
    END;

    RETURN(START_EPI);
END;

/* PARSE_GOTOS -- parse all goto modifiers on statement S.
 *
 * Accepts every SNOBOL4 goto syntax variant on a single statement:
 *
 *     :S(L1)            :F(L1)            :(L1)
 *     :S(L1):F(L2)      :S(L1) :F(L2)     :S(L1)F(L2)
 *     :F(L1):S(L2)      :(RETURN)         :(FRETURN)
 *
 * SNOBOL4 transfer semantics are left-to-right and first-wins: a
 * transfer that fires exits the statement immediately, so a duplicate
 * of the same direction (`:S(L1):S(L2)` or `:F(L1):F(L2)`) is
 * unreachable. We silently drop the duplicate; this matches SPITBOL /
 * Bell Labs Macro Implementation behaviour and the convention noted
 * in the dcsno-combined-goto-parser brief ("document precedence; do
 * not silently drop one").
 *
 * Storage scheme keeps the existing single-slot representation for
 * the FIRST goto (any kind) and adds S_GLBL_F for a SECOND goto in
 * the combined :S/:F form. Kept tight (2 new fields, not 4) so the
 * generated .s stays under PL/SW EMIT_BUF_SIZE = 256KB.
 *
 *   First goto = `:S(L)` alone -> S_GTYP=GT_SUCC,   S_GLBL=L
 *   First goto = `:F(L)` alone -> S_GTYP=GT_FAIL,   S_GLBL=L
 *   First goto = `:(L)`        -> S_GTYP=GT_UNCOND, S_GLBL=L
 *   First goto = `:(RETURN)`   -> S_GTYP=GT_RET,    S_GLBL=-1
 *   First goto = `:(FRETURN)`  -> S_GTYP=GT_FRET,   S_GLBL=-1
 *   Combined `:S(L1):F(L2)`    -> S_GTYP=GT_SUCC, S_GLBL=L1, S_GLBL_F=L2
 *   Combined `:F(L1):S(L2)`    -> S_GTYP=GT_SUCC, S_GLBL=L2, S_GLBL_F=L1
 *   Pathological `:S(L1):S(L2)` -> S_GLBL=L1 (L2 dropped, unreachable)
 *   Pathological `:F(L1):F(L2)` -> S_GLBL=L1 (L2 dropped, unreachable)
 *
 * On entry: TT is on the leading TK_COLON.
 * On exit:  TT is past the last goto's `)`.
 */
PARSE_GOTOS: PROC(S INT);
    DCL G_KIND INT;          /* 0=UNCOND, 1=S, 2=F */
    DCL LBL_IDX INT;
    DCL CONT INT;
    DCL OLD_GLBL INT;

    CONT = 1;
    DO WHILE (CONT = 1);
        CONT = 0;

        /* Leading colon -- always present on the first iteration;
         * optional on the no-colon variant `:S(L1)F(L2)`. */
        IF (TT = TK_COLON) THEN CALL LEX;

        /* Optional S / F modifier; default = UNCOND for `:(L)`. */
        G_KIND = 0;
        IF (TT = TK_IDENT) THEN DO;
            IF (TB(0) = 83 AND TB(1) = 0) THEN DO;
                G_KIND = 1;
                CALL LEX;
            END;
            ELSE IF (TB(0) = 70 AND TB(1) = 0) THEN DO;
                G_KIND = 2;
                CALL LEX;
            END;
        END;

        IF (TT != TK_LPAREN) THEN RETURN;
        CALL LEX;

        IF (TT = TK_IDENT) THEN DO;
            IF (TB(0) = 82 AND TB(1) = 69 AND TB(2) = 84 AND TB(3) = 85 AND TB(4) = 82 AND TB(5) = 78 AND TB(6) = 0) THEN DO;
                S_GTYP(S) = GT_RET;
                S_GLBL(S) = 0 - 1;
                CALL LEX;
            END;
            ELSE IF (TB(0) = 70 AND TB(1) = 82 AND TB(2) = 69 AND TB(3) = 84 AND TB(4) = 85 AND TB(5) = 82 AND TB(6) = 78 AND TB(7) = 0) THEN DO;
                S_GTYP(S) = GT_FRET;
                S_GLBL(S) = 0 - 1;
                CALL LEX;
            END;
            ELSE DO;
                LBL_IDX = SBSAVE();
                CALL LEX;
                IF (G_KIND = 1) THEN DO;
                    /* :S(...) target. SNOBOL4 left-to-right semantics:
                     * the first :S that's reachable wins. A second
                     * :S on the same statement is unreachable -- we
                     * silently drop it (matches SPITBOL / Bell Labs
                     * Macro Implementation behaviour). */
                    IF (S_GTYP(S) = GT_FAIL) THEN DO;
                        /* Reversed order :F(L1):S(L2) -- the existing
                         * F target moves into S_GLBL_F so the primary
                         * slot can hold the new S target. */
                        OLD_GLBL = S_GLBL(S);
                        S_GLBL_F(S) = OLD_GLBL;
                        S_GTYP(S) = GT_SUCC;
                        S_GLBL(S) = LBL_IDX;
                    END;
                    ELSE IF (S_GTYP(S) = GT_SUCC) THEN DO;
                        /* Second :S -- unreachable, drop. */
                    END;
                    ELSE DO;
                        S_GTYP(S) = GT_SUCC;
                        S_GLBL(S) = LBL_IDX;
                    END;
                END;
                ELSE IF (G_KIND = 2) THEN DO;
                    /* :F(...) target. Same first-wins rule. */
                    IF (S_GTYP(S) = GT_SUCC) THEN DO;
                        IF (S_GLBL_F(S) < 0) THEN
                            S_GLBL_F(S) = LBL_IDX;
                        /* else: second :F after combined :S(...):F(...)
                         * -- drop. */
                    END;
                    ELSE IF (S_GTYP(S) = GT_FAIL) THEN DO;
                        /* Second :F -- unreachable, drop. */
                    END;
                    ELSE DO;
                        S_GTYP(S) = GT_FAIL;
                        S_GLBL(S) = LBL_IDX;
                    END;
                END;
                ELSE DO;
                    S_GTYP(S) = GT_UNCOND;
                    S_GLBL(S) = LBL_IDX;
                END;
            END;
        END;

        IF (TT = TK_RPAREN) THEN CALL LEX;

        /* Continue if another goto follows. */
        IF (TT = TK_COLON) THEN CONT = 1;
        ELSE IF (TT = TK_IDENT) THEN DO;
            IF (TB(0) = 83 AND TB(1) = 0) THEN CONT = 1;
            ELSE IF (TB(0) = 70 AND TB(1) = 0) THEN CONT = 1;
        END;
    END;
END;

PARSE: PROC;
    DCL S INT;
    DCL NOFF INT;
    STCNT = 0;
    SBPOS = 0;
    SYMC = 0;
    LBLC = 0;
    FN_CNT = 0;
    SPOS = 0;
    AT_SOL = 1;
    CALL LEX;

    DO WHILE (TT != TK_EOF AND STCNT < STMAX);
        S = STCNT;
        S_TYP(S) = ST_EMPTY;
        S_SUBJ(S) = 0 - 1;
        S_OETY(S) = OE_NONE;
        S_OEV1(S) = 0;
        S_OEOP(S) = 0;
        S_OEV2(S) = 0 - 1;
        S_GTYP(S) = GT_NONE;
        S_GLBL(S) = 0 - 1;
        S_GLBL_F(S) = 0 - 1;
        S_SPTR(S) = 0 - 1;
        S_EPCNT(S) = 0;
        S_PPCNT(S) = 0;
        S_SIDX(S) = 0 - 1;

        IF (TT = TK_EOL) THEN DO;
            CALL LEX;
            STCNT = STCNT + 1;
        END;
        ELSE IF (TT = TK_IDENT AND IS_END() != 0) THEN DO;
            S_TYP(S) = ST_END;
            NOFF = SBSAVE();
            CALL LBL_ADD(NOFF, S);
            CALL LEX;
            IF (TT = TK_EOL) THEN CALL LEX;
            STCNT = STCNT + 1;
        END;
        ELSE IF (TT = TK_IDENT AND IS_DUMP() != 0) THEN DO;
            S_TYP(S) = 5;
            CALL LEX;
            IF (TT = TK_EOL) THEN CALL LEX;
            STCNT = STCNT + 1;
        END;
        ELSE IF (TT = TK_IDENT AND IS_REFLECT() != 0) THEN DO;
            /* "REFLECT VAR" -- in-place pronoun-swap on VAR */
            S_TYP(S) = 6;
            CALL LEX;
            IF (TT = TK_IDENT) THEN DO;
                NOFF = SBSAVE();
                S_SUBJ(S) = SYM_LOOKUP(NOFF);
                CALL LEX;
            END;
            IF (TT = TK_EOL) THEN CALL LEX;
            STCNT = STCNT + 1;
        END;
        ELSE IF (TT = TK_IDENT OR TT = TK_STR) THEN DO;
            IF (LHAS_LBL = 1) THEN DO;
                NOFF = SBSAVE();
                CALL LBL_ADD(NOFF, S);
                CALL LEX;
            END;

            IF (TT = TK_IDENT AND IS_DUMP() != 0) THEN DO;
                S_TYP(S) = 5;
                CALL LEX;
            END;
            ELSE IF (TT = TK_IDENT AND IS_REFLECT() != 0) THEN DO;
                /* labeled "REFLECT VAR" */
                S_TYP(S) = 6;
                CALL LEX;
                IF (TT = TK_IDENT) THEN DO;
                    NOFF = SBSAVE();
                    S_SUBJ(S) = SYM_LOOKUP(NOFF);
                    CALL LEX;
                END;
            END;
            ELSE IF (TT = TK_STR) THEN DO;
                /* Literal subject: 'abc' pattern :goto */
                DCL LSOFF INT;
                LSOFF = SBSAVE();
                TB(0) = 95;   /* temp var name "_" */
                TB(1) = 0;
                NOFF = SBSAVE();
                S_SUBJ(S) = SYM_LOOKUP(NOFF);
                S_OEV2(S) = LSOFF;  /* literal offset for lowering */
                CALL LEX;
            END;
            ELSE IF (TT = TK_IDENT) THEN DO;
                NOFF = SBSAVE();
                S_SUBJ(S) = SYM_LOOKUP(NOFF);
                CALL LEX;
                /* Check for <index> (array element access) */
                IF (TT = TK_LT) THEN DO;
                    CALL LEX;
                    IF (TT = TK_IDENT) THEN DO;
                        NOFF = SBSAVE();
                        S_SIDX(S) = SYM_LOOKUP(NOFF);
                        CALL LEX;
                    END;
                    ELSE IF (TT = TK_INT) THEN DO;
                        /* Literal index -- store as negative (flag) */
                        S_SIDX(S) = 0 - TV - 1;
                        CALL LEX;
                    END;
                    IF (TT = TK_GT) THEN CALL LEX;
                END;
            END;

            /* DEFINE('FNNAME(PARAM)') statement */
            IF (S_SUBJ(S) >= 0 AND TT = TK_LPAREN) THEN DO;
                DCL NP2 PTR;
                NP2 = ADDR(SYMN) + S_SUBJ(S) * SYM_WIDTH;
                IF (NP2->DTAG = 68) THEN DO;
                    DCL NP3 PTR;
                    NP3 = NP2 + 1;
                    IF (NP3->DTAG = 69) THEN DO;
                        /* "DE..." -- assume DEFINE */
                        CALL LEX;  /* past ( */
                        IF (TT = TK_STR) THEN DO;
                            DCL DR INT;
                            DR = DEF_PARSE();
                            CALL LEX;
                        END;
                        IF (TT = TK_RPAREN) THEN CALL LEX;
                        S_TYP(S) = ST_EMPTY;
                        S_SUBJ(S) = 0 - 1;
                    END;
                END;
            END;

            /* Builtin predicate: NAME(arg1,arg2) :S/:F */
            IF (S_SUBJ(S) >= 0 AND TT = TK_LPAREN) THEN DO;
                DCL BC INT;
                BC = BLT_CODE(S_SUBJ(S));
                IF (BC > 0) THEN DO;
                    DCL BEPB INT;
                    DCL BEPI INT;
                    DCL BANO INT;
                    S_TYP(S) = 4;
                    S_OEV1(S) = BC;
                    S_SUBJ(S) = 0 - 1;
                    BEPB = S * EPSLOTS;
                    BEPI = 0;
                    CALL LEX;  /* past ( */
                    /* arg1 -- nested SUBSTR/SIZE/CHAR first, then
                     * fall back to simple IDENT/INT/STR. */
                    DCL NEW_EPI INT;
                    NEW_EPI = PARSE_NESTED_FN(BEPB, BEPI);
                    IF (NEW_EPI > BEPI) THEN BEPI = NEW_EPI;
                    ELSE IF (TT = TK_IDENT) THEN DO;
                        BANO = SBSAVE();
                        EP_TYP(BEPB + BEPI) = OE_IDENT;
                        EP_VAL(BEPB + BEPI) = SYM_LOOKUP(BANO);
                        BEPI = BEPI + 1;
                        CALL LEX;
                    END;
                    ELSE IF (TT = TK_INT) THEN DO;
                        EP_TYP(BEPB + BEPI) = OE_INT;
                        EP_VAL(BEPB + BEPI) = TV;
                        BEPI = BEPI + 1;
                        CALL LEX;
                    END;
                    ELSE IF (TT = TK_STR) THEN DO;
                        EP_TYP(BEPB + BEPI) = OE_STR;
                        EP_VAL(BEPB + BEPI) = SBSAVE();
                        BEPI = BEPI + 1;
                        CALL LEX;
                    END;
                    IF (TT = 17) THEN CALL LEX;
                    /* arg2 -- same nested-first dispatch. */
                    NEW_EPI = PARSE_NESTED_FN(BEPB, BEPI);
                    IF (NEW_EPI > BEPI) THEN BEPI = NEW_EPI;
                    ELSE IF (TT = TK_IDENT) THEN DO;
                        BANO = SBSAVE();
                        EP_TYP(BEPB + BEPI) = OE_IDENT;
                        EP_VAL(BEPB + BEPI) = SYM_LOOKUP(BANO);
                        BEPI = BEPI + 1;
                        CALL LEX;
                    END;
                    ELSE IF (TT = TK_INT) THEN DO;
                        EP_TYP(BEPB + BEPI) = OE_INT;
                        EP_VAL(BEPB + BEPI) = TV;
                        BEPI = BEPI + 1;
                        CALL LEX;
                    END;
                    ELSE IF (TT = TK_STR) THEN DO;
                        EP_TYP(BEPB + BEPI) = OE_STR;
                        EP_VAL(BEPB + BEPI) = SBSAVE();
                        BEPI = BEPI + 1;
                        CALL LEX;
                    END;
                    IF (TT = TK_RPAREN) THEN CALL LEX;
                    S_EPCNT(S) = BEPI;
                END;
            END;

            /* Check: is this a pattern match? (SUBJ parts... :goto)
             * If next token is IDENT (not =) or STR, it's a match stmt */
            IF ((TT = TK_IDENT OR TT = TK_STR) AND S_SUBJ(S) >= 0) THEN DO;
                DCL PPB INT;
                DCL PPI INT;
                S_TYP(S) = ST_MATCH;
                PPB = S * EPSLOTS;
                PPI = 0;

                /* Collect pattern parts until : or = or EOL */
                DO WHILE (TT != TK_COLON AND TT != TK_EQ AND TT != TK_EOL AND TT != TK_EOF AND PPI < EPSLOTS);
                    IF (TT = TK_DOT) THEN DO;
                        /* . CAPTURE */
                        CALL LEX;
                        IF (TT = TK_IDENT) THEN DO;
                            NOFF = SBSAVE();
                            PP_TYP(PPB + PPI) = OE_CAP;
                            PP_VAL(PPB + PPI) = SYM_LOOKUP(NOFF);
                            PPI = PPI + 1;
                            CALL LEX;
                        END;
                    END;
                    ELSE IF (TT = TK_STR) THEN DO;
                        PP_TYP(PPB + PPI) = OE_STR;
                        PP_VAL(PPB + PPI) = SBSAVE();
                        PPI = PPI + 1;
                        CALL LEX;
                    END;
                    ELSE IF (TT = TK_IDENT) THEN DO;
                        NOFF = SBSAVE();
                        /* Check for SPAN/BREAK/REM function */
                        IF (TB(0) = 83 AND TB(1) = 80 AND TB(2) = 65 AND TB(3) = 78 AND TB(4) = 0) THEN DO;
                            CALL LEX;
                            IF (TT = TK_LPAREN) THEN DO;
                                CALL LEX;
                                IF (TT = TK_STR) THEN DO;
                                    PP_TYP(PPB + PPI) = OE_SPAN;
                                    PP_VAL(PPB + PPI) = SBSAVE();
                                    PPI = PPI + 1;
                                    CALL LEX;
                                END;
                                IF (TT = TK_RPAREN) THEN CALL LEX;
                            END;
                        END;
                        ELSE IF (TB(0) = 66 AND TB(1) = 82 AND TB(2) = 69 AND TB(3) = 65 AND TB(4) = 75 AND TB(5) = 0) THEN DO;
                            CALL LEX;
                            IF (TT = TK_LPAREN) THEN DO;
                                CALL LEX;
                                IF (TT = TK_STR) THEN DO;
                                    PP_TYP(PPB + PPI) = OE_BREAK;
                                    PP_VAL(PPB + PPI) = SBSAVE();
                                    PPI = PPI + 1;
                                    CALL LEX;
                                END;
                                IF (TT = TK_RPAREN) THEN CALL LEX;
                            END;
                        END;
                        ELSE IF (TB(0) = 82 AND TB(1) = 69 AND TB(2) = 77 AND TB(3) = 0) THEN DO;
                            PP_TYP(PPB + PPI) = OE_REM;
                            PP_VAL(PPB + PPI) = 0;
                            PPI = PPI + 1;
                            CALL LEX;
                        END;
                        ELSE IF (TB(0) = 76 AND TB(1) = 69 AND TB(2) = 78 AND TB(3) = 0) THEN DO;
                            /* LEN(<int>) or LEN(<var>) -- match N chars */
                            CALL LEX;
                            IF (TT = TK_LPAREN) THEN DO;
                                CALL LEX;
                                IF (TT = TK_INT) THEN DO;
                                    PP_TYP(PPB + PPI) = OE_LEN;
                                    PP_VAL(PPB + PPI) = TV;
                                    PPI = PPI + 1;
                                    CALL LEX;
                                END;
                                ELSE IF (TT = TK_IDENT) THEN DO;
                                    DCL LNOFF INT;
                                    LNOFF = SBSAVE();
                                    PP_TYP(PPB + PPI) = OE_LEN_VAR;
                                    PP_VAL(PPB + PPI) = SYM_LOOKUP(LNOFF);
                                    PPI = PPI + 1;
                                    CALL LEX;
                                END;
                                IF (TT = TK_RPAREN) THEN CALL LEX;
                            END;
                        END;
                        ELSE DO;
                            /* Pattern variable reference */
                            PP_TYP(PPB + PPI) = OE_IDENT;
                            PP_VAL(PPB + PPI) = SYM_LOOKUP(NOFF);
                            PPI = PPI + 1;
                            CALL LEX;
                        END;
                    END;
                    ELSE DO;
                        CALL LEX;
                    END;
                END;

                S_PPCNT(S) = PPI;

                /* Pattern-replacement: SUBJ pattern = replacement */
                IF (TT = TK_EQ) THEN DO;
                    DCL REPI INT;
                    DCL REPB INT;
                    S_TYP(S) = ST_REPL;
                    CALL LEX;
                    REPB = S * EPSLOTS;
                    REPI = 0;
                    DO WHILE ((TT = TK_INT OR TT = TK_STR OR TT = TK_IDENT) AND REPI < EPSLOTS);
                        IF (TT = TK_INT) THEN DO;
                            EP_TYP(REPB + REPI) = OE_INT;
                            EP_VAL(REPB + REPI) = TV;
                            REPI = REPI + 1;
                            CALL LEX;
                        END;
                        ELSE IF (TT = TK_STR) THEN DO;
                            EP_TYP(REPB + REPI) = OE_STR;
                            EP_VAL(REPB + REPI) = SBSAVE();
                            REPI = REPI + 1;
                            CALL LEX;
                        END;
                        ELSE IF (TT = TK_IDENT) THEN DO;
                            DCL RPNO INT;
                            RPNO = SBSAVE();
                            EP_TYP(REPB + REPI) = OE_IDENT;
                            EP_VAL(REPB + REPI) = SYM_LOOKUP(RPNO);
                            REPI = REPI + 1;
                            CALL LEX;
                        END;
                    END;
                    S_EPCNT(S) = REPI;
                    IF (REPI = 1) THEN DO;
                        S_OETY(S) = EP_TYP(REPB);
                        S_OEV1(S) = EP_VAL(REPB);
                        IF (S_OETY(S) = OE_STR) THEN
                            S_SPTR(S) = EP_VAL(REPB);
                    END;
                END;
            END;
            ELSE IF (TT = TK_EQ) THEN DO;
                DCL EPI INT;
                DCL EPB INT;
                S_TYP(S) = ST_ASSIGN;
                CALL LEX;
                EPB = S * EPSLOTS;
                EPI = 0;

                /* Collect expression parts */
                DO WHILE (TT = TK_INT OR TT = TK_STR OR TT = TK_IDENT);
                    IF (TT = TK_INT) THEN DO;
                        IF (EPI < EPSLOTS) THEN DO;
                            EP_TYP(EPB + EPI) = OE_INT;
                            EP_VAL(EPB + EPI) = TV;
                            EPI = EPI + 1;
                        END;
                        CALL LEX;
                    END;
                    ELSE IF (TT = TK_STR) THEN DO;
                        IF (EPI < EPSLOTS) THEN DO;
                            EP_TYP(EPB + EPI) = OE_STR;
                            EP_VAL(EPB + EPI) = SBSAVE();
                            EPI = EPI + 1;
                        END;
                        CALL LEX;
                    END;
                    ELSE IF (TT = TK_IDENT) THEN DO;
                        NOFF = SBSAVE();
                        /* Check for REMDR(A,B) -- two-arg numeric mod */
                        IF (TB(0) = 82 AND TB(1) = 69 AND TB(2) = 77 AND TB(3) = 68 AND TB(4) = 82 AND TB(5) = 0) THEN DO;
                            CALL LEX;
                            IF (TT = TK_LPAREN) THEN DO;
                                CALL LEX;
                                /* arg1 */
                                IF (TT = TK_INT) THEN DO;
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_INT;
                                        EP_VAL(EPB + EPI) = TV;
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                ELSE IF (TT = TK_IDENT) THEN DO;
                                    DCL RNO1 INT;
                                    RNO1 = SBSAVE();
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_IDENT;
                                        EP_VAL(EPB + EPI) = SYM_LOOKUP(RNO1);
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                IF (TT = 17) THEN CALL LEX;
                                /* arg2 */
                                IF (TT = TK_INT) THEN DO;
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_INT;
                                        EP_VAL(EPB + EPI) = TV;
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                ELSE IF (TT = TK_IDENT) THEN DO;
                                    DCL RNO2 INT;
                                    RNO2 = SBSAVE();
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_IDENT;
                                        EP_VAL(EPB + EPI) = SYM_LOOKUP(RNO2);
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                IF (TT = TK_RPAREN) THEN CALL LEX;
                                /* Mark as REMDR binop (use S_OEOP=100) */
                                S_OEOP(S) = 100;
                            END;
                        END;
                        /* Check for SIZE(STR) -- one-arg string length */
                        ELSE IF (TB(0) = 83 AND TB(1) = 73 AND TB(2) = 90 AND TB(3) = 69 AND TB(4) = 0) THEN DO;
                            DCL BLT_AI INT;
                            BLT_AI = EPI;
                            CALL LEX;
                            IF (TT = TK_LPAREN) THEN DO;
                                CALL LEX;
                                IF (TT = TK_IDENT) THEN DO;
                                    DCL SZNO1 INT;
                                    SZNO1 = SBSAVE();
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_IDENT;
                                        EP_VAL(EPB + EPI) = SYM_LOOKUP(SZNO1);
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                ELSE IF (TT = TK_STR) THEN DO;
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_STR;
                                        EP_VAL(EPB + EPI) = SBSAVE();
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                IF (TT = TK_RPAREN) THEN CALL LEX;
                                IF (EPI < EPSLOTS) THEN DO;
                                    EP_TYP(EPB + EPI) = OE_SIZE;
                                    IF (BLT_AI > 0) THEN
                                        EP_VAL(EPB + EPI) = 0 - BLT_AI;
                                    ELSE
                                        EP_VAL(EPB + EPI) = 0;
                                    EPI = EPI + 1;
                                END;
                            END;
                        END;
                        /* Check for SUBSTR(STR,POS,LEN) -- three-arg substring */
                        ELSE IF (TB(0) = 83 AND TB(1) = 85 AND TB(2) = 66 AND TB(3) = 83 AND TB(4) = 84 AND TB(5) = 82 AND TB(6) = 0) THEN DO;
                            DCL BLT_AI INT;
                            BLT_AI = EPI;
                            CALL LEX;
                            IF (TT = TK_LPAREN) THEN DO;
                                CALL LEX;
                                /* arg1: string */
                                IF (TT = TK_IDENT) THEN DO;
                                    DCL SBNO1 INT;
                                    SBNO1 = SBSAVE();
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_IDENT;
                                        EP_VAL(EPB + EPI) = SYM_LOOKUP(SBNO1);
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                ELSE IF (TT = TK_STR) THEN DO;
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_STR;
                                        EP_VAL(EPB + EPI) = SBSAVE();
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                IF (TT = 17) THEN CALL LEX;
                                /* arg2: position */
                                IF (TT = TK_INT) THEN DO;
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_INT;
                                        EP_VAL(EPB + EPI) = TV;
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                ELSE IF (TT = TK_IDENT) THEN DO;
                                    DCL SBNO2 INT;
                                    SBNO2 = SBSAVE();
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_IDENT;
                                        EP_VAL(EPB + EPI) = SYM_LOOKUP(SBNO2);
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                IF (TT = 17) THEN CALL LEX;
                                /* arg3: length */
                                IF (TT = TK_INT) THEN DO;
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_INT;
                                        EP_VAL(EPB + EPI) = TV;
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                ELSE IF (TT = TK_IDENT) THEN DO;
                                    DCL SBNO3 INT;
                                    SBNO3 = SBSAVE();
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_IDENT;
                                        EP_VAL(EPB + EPI) = SYM_LOOKUP(SBNO3);
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                IF (TT = TK_RPAREN) THEN CALL LEX;
                                IF (EPI < EPSLOTS) THEN DO;
                                    EP_TYP(EPB + EPI) = OE_SUBSTR;
                                    IF (BLT_AI > 0) THEN
                                        EP_VAL(EPB + EPI) = 0 - BLT_AI;
                                    ELSE
                                        EP_VAL(EPB + EPI) = 0;

                                    EPI = EPI + 1;
                                END;
                            END;
                        END;
                        /* Check for CHAR(CODE) -- one-arg code-to-char */
                        ELSE IF (TB(0) = 67 AND TB(1) = 72 AND TB(2) = 65 AND TB(3) = 82 AND TB(4) = 0) THEN DO;
                            DCL BLT_AI INT;
                            BLT_AI = EPI;
                            CALL LEX;
                            IF (TT = TK_LPAREN) THEN DO;
                                CALL LEX;
                                IF (TT = TK_INT) THEN DO;
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_INT;
                                        EP_VAL(EPB + EPI) = TV;
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                ELSE IF (TT = TK_IDENT) THEN DO;
                                    DCL CHNO1 INT;
                                    CHNO1 = SBSAVE();
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_IDENT;
                                        EP_VAL(EPB + EPI) = SYM_LOOKUP(CHNO1);
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                IF (TT = TK_RPAREN) THEN CALL LEX;
                                IF (EPI < EPSLOTS) THEN DO;
                                    EP_TYP(EPB + EPI) = OE_CHAR;
                                    IF (BLT_AI > 0) THEN
                                        EP_VAL(EPB + EPI) = 0 - BLT_AI;
                                    ELSE
                                        EP_VAL(EPB + EPI) = 0;
                                    EPI = EPI + 1;
                                END;
                            END;
                        END;
                        /* Check for SPAN/ARRAY(...) */
                        ELSE IF (TB(0) = 83 AND TB(1) = 80 AND TB(2) = 65 AND TB(3) = 78 AND TB(4) = 0) THEN DO;
                            CALL LEX;
                            IF (TT = TK_LPAREN) THEN DO;
                                CALL LEX;
                                IF (TT = TK_STR) THEN DO;
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_SPAN;
                                        EP_VAL(EPB + EPI) = SBSAVE();
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                IF (TT = TK_RPAREN) THEN CALL LEX;
                            END;
                        END;
                        /* Check for BREAK(...) in expression */
                        ELSE IF (TB(0) = 66 AND TB(1) = 82 AND TB(2) = 69 AND TB(3) = 65 AND TB(4) = 75 AND TB(5) = 0) THEN DO;
                            CALL LEX;
                            IF (TT = TK_LPAREN) THEN DO;
                                CALL LEX;
                                IF (TT = TK_STR) THEN DO;
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_BREAK;
                                        EP_VAL(EPB + EPI) = SBSAVE();
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                IF (TT = TK_RPAREN) THEN CALL LEX;
                            END;
                        END;
                        ELSE IF (TB(0) = 65 AND TB(1) = 82 AND TB(2) = 82 AND TB(3) = 65 AND TB(4) = 89 AND TB(5) = 0) THEN DO;
                            /* ARRAY('1:50') */
                            CALL LEX;
                            IF (TT = TK_LPAREN) THEN DO;
                                CALL LEX;
                                IF (TT = TK_STR) THEN CALL LEX;
                                IF (TT = TK_RPAREN) THEN CALL LEX;
                            END;
                            IF (EPI < EPSLOTS) THEN DO;
                                EP_TYP(EPB + EPI) = OE_ARRAY;
                                EP_VAL(EPB + EPI) = 0;
                                EPI = EPI + 1;
                            END;
                        END;
                        ELSE DO;
                            DCL SYMIDX INT;
                            DCL FNIDX INT;
                            SYMIDX = SYM_LOOKUP(NOFF);
                            CALL LEX;
                            FNIDX = 0 - 1;
                            IF (TT = TK_LPAREN) THEN
                                FNIDX = FN_FIND(SYMIDX);
                            /* Function call: NAME(ARG) */
                            IF (FNIDX >= 0) THEN DO;
                                IF (1 = 1) THEN DO;
                                    CALL LEX;  /* past ( */
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_FNCALL;
                                        EP_VAL(EPB + EPI) = FNIDX;
                                        EPI = EPI + 1;
                                    END;
                                    /* Single arg: IDENT, INT, or STR */
                                    IF (TT = TK_IDENT) THEN DO;
                                        DCL ANO INT;
                                        ANO = SBSAVE();
                                        IF (EPI < EPSLOTS) THEN DO;
                                            EP_TYP(EPB + EPI) = OE_IDENT;
                                            EP_VAL(EPB + EPI) = SYM_LOOKUP(ANO);
                                            EPI = EPI + 1;
                                        END;
                                        CALL LEX;
                                    END;
                                    ELSE IF (TT = TK_INT) THEN DO;
                                        IF (EPI < EPSLOTS) THEN DO;
                                            EP_TYP(EPB + EPI) = OE_INT;
                                            EP_VAL(EPB + EPI) = TV;
                                            EPI = EPI + 1;
                                        END;
                                        CALL LEX;
                                    END;
                                    ELSE IF (TT = TK_STR) THEN DO;
                                        IF (EPI < EPSLOTS) THEN DO;
                                            EP_TYP(EPB + EPI) = OE_STR;
                                            EP_VAL(EPB + EPI) = SBSAVE();
                                            EPI = EPI + 1;
                                        END;
                                        CALL LEX;
                                    END;
                                    IF (TT = TK_RPAREN) THEN CALL LEX;
                                END;
                            END;
                            /* Check for <index> (array ref in expr) */
                            ELSE IF (TT = TK_LT) THEN DO;
                                CALL LEX;
                                IF (EPI < EPSLOTS) THEN DO;
                                    EP_TYP(EPB + EPI) = OE_ARRREF;
                                    EP_VAL(EPB + EPI) = SYMIDX;
                                    EPI = EPI + 1;
                                END;
                                /* Index: ident or int */
                                IF (TT = TK_IDENT) THEN DO;
                                    NOFF = SBSAVE();
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_IDENT;
                                        EP_VAL(EPB + EPI) = SYM_LOOKUP(NOFF);
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                ELSE IF (TT = TK_INT) THEN DO;
                                    IF (EPI < EPSLOTS) THEN DO;
                                        EP_TYP(EPB + EPI) = OE_INT;
                                        EP_VAL(EPB + EPI) = TV;
                                        EPI = EPI + 1;
                                    END;
                                    CALL LEX;
                                END;
                                IF (TT = TK_GT) THEN CALL LEX;
                            END;
                            ELSE DO;
                                IF (EPI < EPSLOTS) THEN DO;
                                    EP_TYP(EPB + EPI) = OE_IDENT;
                                    EP_VAL(EPB + EPI) = SYMIDX;
                                    EPI = EPI + 1;
                                END;
                            END;
                        END;
                    END;

                    /* Check for binary operator */
                    IF (TT = TK_PLUS OR TT = TK_MINUS OR TT = TK_STAR) THEN DO;
                        /* Store op, then parse second operand on next loop */
                        S_OEOP(S) = TT;
                        CALL LEX;
                    END;
                END;

                S_EPCNT(S) = EPI;
                /* For backward compat: if 1 part, set S_OETY/S_OEV1 */
                IF (EPI = 1) THEN DO;
                    S_OETY(S) = EP_TYP(EPB);
                    S_OEV1(S) = EP_VAL(EPB);
                    IF (S_OETY(S) = OE_STR OR S_OETY(S) = OE_SPAN OR S_OETY(S) = OE_BREAK) THEN
                        S_SPTR(S) = EP_VAL(EPB);
                END;
                ELSE IF (EPI = 2 AND S_OEOP(S) != 0) THEN DO;
                    /* Binary op: part0 OP part1 */
                    S_OETY(S) = OE_BINOP;
                    S_OEV1(S) = EP_VAL(EPB);
                    S_OEV2(S) = EP_VAL(EPB + 1);
                END;
                ELSE IF (EPI >= 2) THEN DO;
                    /* Concatenation */
                    S_OETY(S) = OE_NONE;
                END;
            END;

            IF (TT = TK_COLON) THEN CALL PARSE_GOTOS(S);

            DO WHILE (TT != TK_EOL AND TT != TK_EOF);
                CALL LEX;
            END;
            IF (TT = TK_EOL) THEN CALL LEX;
            STCNT = STCNT + 1;
        END;
        ELSE IF (TT = TK_COLON) THEN DO;
            CALL PARSE_GOTOS(S);
            DO WHILE (TT != TK_EOL AND TT != TK_EOF);
                CALL LEX;
            END;
            IF (TT = TK_EOL) THEN CALL LEX;
            STCNT = STCNT + 1;
        END;
        ELSE DO;
            CALL LEX;
        END;
    END;

    /* Resolve FN_ENTRY via label lookup */
    DCL FI INT;
    FI = 0;
    DO WHILE (FI < FN_CNT);
        FN_ENTRY(FI) = LBL_FIND(FN_NAMOFF(FI));
        FI = FI + 1;
    END;
END;

/* ================================================================
 * AM code buffer + emitter
/* ================================================================ */

/* AM_CODE, AM_PC, STMT_ADDR declared in snoglob.msw */

/* Dummy MAIN for library compilation */
MAIN: PROC;
END;
